strengthLabel.TextSize = 20
local durabilityLabel = StatsTab:AddLabel("Durability: 0 | Gained: 0")
durabilityLabel.TextSize = 20

local trackingStart = tick()
local startStrength = strengthStat.Value
local startDurability = durabilityStat.Value
local tracking = false
local strengthHistory = {}
local durabilityHistory = {}
local historyWindow = 10

task.spawn(function()
	local lastUpdate = tick()
	while true do
		local now = tick()
		local currStr = strengthStat.Value
		local currDur = durabilityStat.Value

		if not tracking and currStr - startStrength >= 1e11 then
			tracking = true
			trackingStart = tick()
			strengthHistory = {}
			durabilityHistory = {}
		end

		if tracking then
			local elapsed = now - trackingStart
			local d = math.floor(elapsed / 86400)
			local h = math.floor(elapsed % 86400 / 3600)
			local m = math.floor(elapsed % 3600 / 60)
			local s = math.floor(elapsed % 60)
			fastRepLabel.Text = string.format("Fast Rep Time: %dd %dh %dm %ds", d, h, m, s)

			strengthLabel.Text = "Strength: " .. formatNumber(currStr) .. " | Gained: " .. formatNumber(currStr - startStrength)
			durabilityLabel.Text = "Durability: " .. formatNumber(currDur) .. " | Gained: " .. formatNumber(currDur - startDurability)

			table.insert(strengthHistory, {time = now, value = currStr})
			table.insert(durabilityHistory, {time = now, value = currDur})

			while #strengthHistory > 0 and now - strengthHistory[1].time > historyWindow do
				table.remove(strengthHistory, 1)
			end
			while #durabilityHistory > 0 and now - durabilityHistory[1].time > historyWindow do
				table.remove(durabilityHistory, 1)
			end

			if now - lastUpdate >= historyWindow then
				lastUpdate = now
				if #strengthHistory >= 2 then
					local rate = (strengthHistory[#strengthHistory].value - strengthHistory[1].value) / historyWindow
					strengthRateLabel.Text = "Strength Rate: " .. formatNumber(math.floor(rate * 3600)) .. "/Hour | " .. formatNumber(math.floor(rate * 86400)) .. "/Day | " .. formatNumber(math.floor(rate * 604800)) .. "/Week | " .. formatNumber(math.floor(rate * 2592000)) .. "/Month"
				end
				if #durabilityHistory >= 2 then
					local rate = (durabilityHistory[#durabilityHistory].value - durabilityHistory[1].value) / historyWindow
					durabilityRateLabel.Text = "Durability Rate: " .. formatNumber(math.floor(rate * 3600)) .. "/Hour | " .. formatNumber(math.floor(rate * 86400)) .. "/Day | " .. formatNumber(math.floor(rate * 604800)) .. "/Week | " .. formatNumber(math.floor(rate * 2592000)) .. "/Month"
				end
			end
		end
		task.wait(0.05)
	end
end)

