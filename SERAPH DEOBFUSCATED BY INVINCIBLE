local function toCamelCase(str)
	local parts = {}
	for word in str:gmatch("%S+") do
		table.insert(parts, word:lower())
	end
	for i = 2, #parts do
		parts[i] = parts[i]:sub(1, 1):upper() .. parts[i]:sub(2)
	end
	return table.concat(parts)
end

local function eatRandom(count)
	local list = {}
	for _, name in ipairs(consumables) do
		table.insert(list, name)
	end
	for i = #list, 2, -1 do
		local j = math.random(i)
		list[i], list[j] = list[j], list[i]
	end
	for i = 1, math.min(count, #list) do
		local item = LocalPlayer.Character:FindFirstChild(list[i]) or LocalPlayer.Backpack:FindFirstChild(list[i])
		if item then
			LocalPlayer.muscleEvent:FireServer(toCamelCase(list[i]), item)
		end
	end
end

